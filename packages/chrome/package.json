{
  "name": "clean-the-mess-chrome",
  "version": "2.1.0",
  "description": "",
  "devDependencies": {},
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "manifest": "node ../../scripts/merge-manifests.js -f ./manifest.chrome.json  > ./manifest.json",
    "build": "pnpm manifest && rimraf dist && BROWSER_NAME=chrome parcel build ./manifest.json --no-content-hash --no-cache --no-source-maps --dist-dir dist",
    "start": "web-ext run -t chromium -s ./dist --bc -c ../../web-ext-config.js",
    "dev": "pnpm manifest && BROWSER_NAME=chrome parcel ./manifest.json --dist-dir dist",
    "build:release": "pnpm build && rimraf ./build && web-ext build -a ./build -s ./dist"
  },
  "author": "Tomas Hartman <tomas.hartman@hotmail.com>",
  "license": "ISC"
}
