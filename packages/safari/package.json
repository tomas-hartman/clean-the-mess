{
  "name": "clean-the-mess-safari",
  "version": "2.1.0",
  "description": "",
  "devDependencies": {},
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "manifest": "node ../../scripts/merge-manifests.js -f ./manifest.safari.json  > ./manifest.json",
    "build": "pnpm manifest && rimraf dist && BROWSER_NAME=safari parcel build ./manifest.json --no-cache --no-content-hash --no-source-maps --dist-dir ./dist && ./scripts/xcode-ref-resources.sh",
    "dev": "pnpm manifest && BROWSER_NAME=safari parcel ./manifest.json --dist-dir ./dist && ./scripts/xcode-ref-resources.sh",
    "__prebuild:release": "pnpm build",
    "__build:release": "rimraf ./build && web-ext build -a ./build -s ./dist",
    "__postbuild:release": "pnpm build:pack-src",
    "__build:pack-src": "sh ../../scripts/ff-pack-src.sh && dir-archiver --src ./build/src_clean_the_mess --dest ./build/src_clean_the_mess.zip && rimraf ./build/src_clean_the_mess"
  },
  "dependencies": {
    "webextension-polyfill": "^0.10.0"
  },
  "author": "Tomas Hartman <tomas.hartman@hotmail.com>",
  "license": "ISC"
}
